# =============================================================================
# Mohamed Job Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_URL=http://localhost:5678

# --- Timezone ---
TZ=Africa/Cairo
GENERIC_TIMEZONE=Africa/Cairo

# --- Database ---
DB_PATH=./data/jobs.db

# --- Gmail (configured via n8n OAuth — no secrets here) ---
# Gmail query for LinkedIn alerts
GMAIL_QUERY=from:jobs-noreply@linkedin.com

# --- Job Analysis ---
# Minimum fit score to shortlist (0-100)
FIT_THRESHOLD_SHORTLIST=80
FIT_THRESHOLD_REVIEW=65

# --- Document Generation ---
OUTPUT_FORMAT=pdf,docx

# --- Browser Automation ---
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=100

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/job-agent.log
